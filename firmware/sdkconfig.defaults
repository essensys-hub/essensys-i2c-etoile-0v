# Profil « dev » (par défaut) : Secure Boot et chiffrement flash DÉSACTIVÉS pour
# pouvoir reflasher la carte de banc. La vérification de signature des images
# OTA reste active (tâche 7.3). Profil de production : sdkconfig.defaults.release.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Table de partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Images d'application signées (RSA-3072, schéma Secure Boot V2), vérifiées à la mise à jour.
# Les binaires sont signés hors du dépôt : espsecure.py sign_data --version 2 --keyfile <clé hors dépôt>
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_SIGNED_ON_BOOT_NO_SECURE_BOOT is not set
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

# OTA avec retour arrière si la nouvelle image ne se valide pas
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Ordonnanceur 1 kHz (tâche de décodage I2C)
CONFIG_FREERTOS_HZ=1000

# Console locale sur l'USB-Serial-JTAG intégré (debug et actions locales)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Réseau : TLS obligatoire pour MQTT et OTA
CONFIG_ESP_TLS_USING_MBEDTLS=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
CONFIG_MQTT_TRANSPORT_SSL=y
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
# CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP is not set

# Wi-Fi : WPA3-SAE accepté
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# Pas de gestion d'énergie dynamique : l'horloge CPU sert à horodater les fronts I2C
# CONFIG_PM_ENABLE is not set

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
